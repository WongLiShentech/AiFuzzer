# Copy to .env and adjust. .env is gitignored — never commit secrets.

# --- Toolchain (resolved at runtime; not hardcoded in source) ---
SOLC_VERSION=0.8.25
ECHIDNA_TEST_LIMIT=50000

# --- Local blockchain (EVM-compatible; configurable) ---
RPC_URL=http://127.0.0.1:8545

# --- Local AI stack (air-gapped) ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b       # generator (fits 6GB VRAM at Q4; pin the tag)
EMBED_MODEL=nomic-embed-text        # embedder for RAG retrieval
CHROMA_COLLECTION=aifuzz-knowledge
CHROMA_PATH=chroma_data             # embedded on-disk vector store (no server/cloud)
RAG_CORPUS_DIR=tests/fixtures       # corpus indexed on first run (offline sample)

# --- Dashboard ---
PORT=5000
FLASK_DEBUG=0
