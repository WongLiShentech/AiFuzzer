          "message": {
            "text": "Lack of Signature Verification\n\nThe `revoke` function does not verify the signature of the message sender.\n\nImpact: Authentication bypass\n\nRemediation: Implement signature verification using `require(msg.sender)` or similar"
          },
          "locations": [
