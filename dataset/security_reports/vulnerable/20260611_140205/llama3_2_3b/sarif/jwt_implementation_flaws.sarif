                },
                "region": {
                  "snippet": {
                    "text": "function revoke(bytes32 _operation) external {\n  uint ownerIndex = m_ownerIndex[uint(msg.sender)];\n  // make sure they're an owner\n  if (ownerIndex == 0) return;\n  uint ownerIndexBit = 2**ownerIndex;\n  var pending = m_pending[_operation];\n  if (pending.ownersDone & ownerIndexBit > 0) {\n    pending.yetNeeded++;\n    pending.ownersDone -= ownerIndexBit;\n    Revoke(msg.sender, _operation);\n  }\n}"
                  },
                  "startLine": 134,
                  "endLine": 134
                }
              }
            }
          ],
