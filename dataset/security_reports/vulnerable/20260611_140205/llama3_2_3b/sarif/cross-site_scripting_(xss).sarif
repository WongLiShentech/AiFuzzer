          "level": "error",
          "message": {
            "text": "Cross-Site Scripting (XSS)\n\nUnescaped output to HTML can lead to XSS vulnerabilities. The `transfer` function is used directly with user input without proper sanitization.\n\nImpact: Potential session hijacking or credential theft via an intermediary contract\n\nRemediation: Use a safer function like `transfer() { require(tx.origin == owner); }` or sanitize user input before passing it to the `transfer()` function"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
