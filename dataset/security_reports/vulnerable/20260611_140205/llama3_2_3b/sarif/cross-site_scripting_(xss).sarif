          "level": "error",
          "message": {
            "text": "Vulnerability found\n\nThe use of msg.sender.call.value() with user input allows an attacker to inject arbitrary JavaScript code.\n\nImpact: Can lead to session hijacking, credential theft, or delivery of malware to users\n\nRemediation: Use msg.sender.call.value with strict encoding (e.g. encode(_am) instead of _am)"
          },
          "locations": [
