          }
        },
        {
          "ruleId": "session-management-issues",
          "level": "warning",
          "message": {
            "text": "Missing Session Timeout\n\nThis line prevents the owner index from being reset to a new value after removal, allowing an attacker to manipulate session IDs.\n\nImpact: An attacker could create multiple valid session IDs and gain unauthorized access to user accounts.\n\nRemediation: Implement a proper timeout mechanism to update m_ownerIndex after removal."
          },
          "locations": [
