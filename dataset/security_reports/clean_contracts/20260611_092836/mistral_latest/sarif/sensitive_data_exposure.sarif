          "rules": [
            {
              "id": "sensitive-data-exposure",
              "name": "Sensitive Data Exposure",
              "shortDescription": {
                "text": "Instances where sensitive information is not properly protected"
              },
              "fullDescription": {
                "text": "**Sensitive Data Exposure**\n\nInstances where sensitive information is not properly protected\n\n**Impact (type metadata)**\nExposure of confidential information, credentials, or personal data leading to unauthorized access\n\n**Mitigation (type metadata)**\nEncrypt sensitive data, use secure storage solutions, and avoid hardcoding secrets"
              },
              "helpUri": "https://github.com/psyray/oasis"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "sensitive-data-exposure",
          "level": "warning",
          "message": {
            "text": "Vulnerability found\n\nThe contract stores credit values in plaintext, exposing the balance of each address.\n\nImpact: Exposure of user balances\n\nRemediation: Store sensitive data encrypted, or use a secure storage solution to protect the user balances."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/work/project/dataset/clean/simple_dao_fixed.sol"
                },
                "region": {
                  "snippet": {
