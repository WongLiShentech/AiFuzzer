                  },
                  "startLine": 25,
                  "endLine": 25
                }
              }
            }
          ],
          "properties": {
            "oasisModel": "mistral:latest",
            "oasisFileSimilarity": 0.6001129080714301,
            "oasisChunkIndex": 0,
