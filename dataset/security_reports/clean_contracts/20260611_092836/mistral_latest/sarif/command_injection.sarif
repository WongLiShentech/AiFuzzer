          "level": "warning",
          "message": {
            "text": "Vulnerability found\n\nThe function 'supportsToken' does not sanitize the user input (the abi encoded packed string), making it vulnerable to command injection.\n\nImpact: Arbitrary OS command execution\n\nRemediation: 'supportsToken' function should sanitize user input before passing it to system()"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/work/project/dataset/clean/modifier_reentrancy_fixed.sol"
                },
                "region": {
                  "snippet": {
