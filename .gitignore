# Generated analysis output — never committed
results/
crytic-export/

# Embedded ChromaDB vector store — rebuilt from the corpus on first run
chroma_data/

# Reference dataset downloaded from Hugging Face (not bundled; see README)
dataset/

# Eval / scratch working dirs — regenerated per run, never committed
_eval/
_fuzzcheck/
# Raw per-contract results are ignored by default (scratch, corpus dumps, logs), but
# the arm result files themselves are tracked below: they are the evidence behind every
# number in the report, and both machines need them to build combined figures.
eval_out/*
!eval_out/results.jsonl
!eval_out/B2_*.jsonl
!eval_out/B3_*.jsonl
!eval_out/frozen_A.jsonl
# dashboard host-side fuzz workdir (staged per request)
_dash/
# generated figures + tables (run make_figures.py / make_report.py)
# Figures and tables ARE tracked: they are the artifacts the report cites, they are
# small (<1 MB), and regenerating them requires the full corpus plus a completed run.
# eval_results/  (intentionally not ignored)
# scratch demo contract copies
_demo_target.sol
_dash_target.sol

# Author's private materials — paper draft, prof report, demo script, code walkthrough
for-me/

# Source repos — cloned locally for the dataset, never committed
staging/

# Local editor / tooling config — never committed
CLAUDE.md
.claude/

# Secrets
.env

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# Node / Foundry / Hardhat artifacts
node_modules/
out/
cache/
artifacts/

# OS
.DS_Store
Thumbs.db

# superseded vector store from the 4746-contract corpus
chroma_data_old_*/

# extracted text of third-party papers, kept locally for reference only
_ilf.txt
